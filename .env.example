# Core
APP_NAME=Braind Server
DEBUG=false
DATA_DIR=./data

# PostgreSQL — replace with local credentials; do not commit a real .env file.
# The '@' in a password must stay %-escaped inside the URI.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/braind

# vLLM — two local GPU servers (chat and embeddings), one card each
VLLM_LLM_BASE_URL=http://127.0.0.1:8001
VLLM_EMBED_BASE_URL=http://127.0.0.1:8002
LLM_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
EMBED_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
EMBEDDING_DIMENSIONS=1024
LLM_TEMPERATURE=0.7
# Must stay well below the chat server's --max-model-len (16384): vLLM counts
# output tokens against the same window as the prompt, so a value equal to the
# context length leaves zero room for input and every request 400s.
LLM_MAX_TOKENS=2048

# vLLM GPU split — chat on card 0, embedding on card 1
VLLM_LLM_GPU=0
VLLM_EMBED_GPU=1
VLLM_LLM_GPU_MEM_UTIL=0.62
VLLM_EMBED_GPU_MEM_UTIL=0.12
VLLM_LLM_MAX_MODEL_LEN=16384
VLLM_EMBED_MAX_MODEL_LEN=8192
VLLM_TOOL_CALL_PARSER=gemma4

# Obsidian vault
VAULT_DIR=./vault
WATCH_INTERVAL_SECONDS=30

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
SCORE_THRESHOLD=0.4

# Writer
WRITER_MAX_VARIANTS=3
WRITER_WEB_CHECK_ENABLED=true
WRITER_WEB_MAX_RESULTS=5
WRITER_WEB_SIMILARITY_THRESHOLD=0.65
WRITER_WEB_FETCH_TIMEOUT_SECONDS=12.0
WRITER_WEB_MAX_PAGE_CHARS=30000
WRITER_WEB_MAX_RESPONSE_BYTES=1500000

# Scheduler
SCHEDULER_ENABLED=true
RSS_REFRESH_MINUTES=60
RSS_FEEDS=[]
DIGEST_HOUR=7
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# Deep learning crawler
LEARN_CONCURRENCY=4
LEARN_MAX_DEPTH=2
LEARN_PER_LEVEL=5
LEARN_MAX_TOTAL_PAGES=40
LEARN_LINKS_PER_PAGE=5
LEARN_HARD_TIMEOUT_SEC=240.0
LEARN_MIN_LINK_LEN=40
LEARN_MAX_LOG=400

# HTTP server — loopback by default; there is no API authentication layer, so
# only widen HOST after putting a reverse proxy or firewall in front.
HOST=127.0.0.1
PORT=8000
CORS_ALLOW_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Outbound HTTP safety (web tool, RSS, crawler share these caps)
OUTBOUND_FETCH_TIMEOUT_SECONDS=20.0
OUTBOUND_MAX_RESPONSE_BYTES=2000000

# Stealth web layer — see core/config.py for the full contract
OUTBOUND_STEALTH_DEFAULT=true
OUTBOUND_IMPERSONATE_TARGETS=["chrome136","chrome133a","chrome131"]
OUTBOUND_ACCEPT_LANGUAGES=["en-US,en;q=0.9","vi-VN,vi;q=0.9,en;q=0.8"]
OUTBOUND_PROFILE_HOST_AFFINITY=true
OUTBOUND_PROFILE_JITTER=0.0
OUTBOUND_MAX_REDIRECTS=5
OUTBOUND_RETRY_ATTEMPTS=2
OUTBOUND_RETRY_BASE_DELAY=1.0
OUTBOUND_RETRY_MAX_DELAY=8.0
READABILITY_ENGINE=trafilatura
READABILITY_FAVOR_RECALL=true
READABILITY_MIN_CHARS=0

# Site crawl (POST /api/learn/site). Depth alone does not bound a real site —
# the page cap and the wall-clock timeout are what stop a run.
CRAWL_MAX_DEPTH=10
CRAWL_MAX_PAGES=300
CRAWL_LINKS_PER_PAGE=20
CRAWL_CONCURRENCY=4
CRAWL_HARD_TIMEOUT_SEC=1800
CRAWL_MIN_CONTENT_CHARS=200

# Chunking. A block shorter than this is a fragment (a table cell, a bare
# label) and is merged with its neighbours instead of becoming its own chunk.
CHUNK_MIN_CHARS=200

# Uploads (POST /api/ingest/file)
UPLOAD_MAX_BYTES=25000000

# Maintenance window (dedup scan, contradiction scan, re-embed NULL vectors)
MAINTENANCE_TIME=00:00
MAINTENANCE_TIMEZONE=Asia/Ho_Chi_Minh
